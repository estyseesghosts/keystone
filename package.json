{
  "name": "keystone",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "./src/platform/polyfills*",
    "./index.ts",
    "./index.web.ts"
  ],
  "engines": {
    "node": ">=24.19.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.14.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build-web": "expo export --platform web",
    "test": "NODE_ENV=test jest --forceExit --testTimeout=20000 --bail",
    "test-watch": "NODE_ENV=test jest --watchAll",
    "test-ci": "NODE_ENV=test jest --ci --forceExit --reporters=default",
    "typecheck": "pnpm run typecheck:ios && pnpm run typecheck:android && pnpm run typecheck:web",
    "typecheck:ios": "tsc --project ./tsconfig.check.ios.json",
    "typecheck:android": "tsc --project ./tsconfig.check.android.json",
    "typecheck:web": "tsc --project ./tsconfig.check.web.json",
    "lint": "oxlint --quiet src && eslint .",
    "intl:extract": "lingui extract --clean --locale en",
    "intl:compile": "lingui compile",
    "prettier": "prettier --check .",
    "smoke": "esbuild scripts/fedi-smoke.ts --bundle --platform=node --format=cjs --outfile=scripts/.fedi-smoke.bundle.cjs --log-level=warning && node scripts/.fedi-smoke.bundle.cjs"
  },
  "dependencies": {
    "@lingui/core": "^5.9.2",
    "@lingui/react": "^5.9.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "@tanstack/query-async-storage-persister": "^5.96.2",
    "@tanstack/react-query": "^5.96.2",
    "@tanstack/react-query-persist-client": "^5.96.2",
    "eventemitter3": "^5.0.1",
    "expo": "57.0.24",
    "expo-asset": "~57.0.18",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.2",
    "expo-dev-client": "~57.0.19",
    "expo-image": "^58.0.15",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.10",
    "expo-secure-store": "^58.0.2",
    "expo-system-ui": "~57.0.4",
    "expo-video": "^58.0.11",
    "expo-web-browser": "~57.0.3",
    "htmlparser2": "^12.0.0",
    "mfm-js": "^0.27.0",
    "react": "19.2.3",
    "react-compiler-runtime": "1.0.0",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "0.13.0",
    "react-responsive": "^10.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-class-static-block": "^7.26.0",
    "@babel/plugin-transform-dynamic-import": "^7.27.1",
    "@lingui/babel-plugin-lingui-macro": "^5.9.2",
    "@lingui/cli": "^5.9.2",
    "@lingui/macro": "^5.9.2",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/typescript-config": "^0.81.5",
    "@testing-library/react-native": "^13.2.0",
    "@types/jest": "29.5.14",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.0.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-preset-expo": "~57.0.12",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "oxlint": "^1.73.0",
    "prettier": "3.9.6",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.9.2"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "setupFilesAfterEnv": [
      "./jest/jestSetup.js"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "transform": {
      "\\.[jt]sx?$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|native-base|react-native-svg|htmlparser2|domhandler|domutils|dom-serializer|entities|domelementtype)"
    ]
  },
  "browserslist": {
    "production": [
      "chrome >= 97",
      "and_chr >= 97",
      "edge >= 97",
      "firefox >= 104",
      "and_ff >= 104",
      "safari >= 15.4",
      "ios_saf >= 15.4",
      "samsung >= 18"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
