<?xml version="1.0" encoding="utf-8"?>
<!--
  X1.6 (security M2 / privacy 3): API 31+ counterpart of
  backup_rules.xml, same exclusion. Dormant unless backups are
  re-enabled.
-->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="file" path="mmkv/" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="file" path="mmkv/" />
  </device-transfer>
</data-extraction-rules>
