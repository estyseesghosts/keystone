{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "moduleSuffixes": [".web", ""],
    "paths": {
      "#/*": ["./src/*"],
      "@keystone/fedi": ["./packages/fedi/src/index.ts"],
      "@keystone/fedi/*": ["./packages/fedi/src/*"]
    }
  },
  "include": ["index.web.ts", "src/**/*.web.ts", "src/**/*.web.tsx"]
}
